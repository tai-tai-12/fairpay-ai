# FairPay AI v0.4: standalone, free local AI. No old project needed.
PORT=3000
HOST=127.0.0.1

# Free AI running entirely on this Mac:
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b-instruct

# Copy from PayPal Developer Dashboard -> Sandbox -> Apps & Credentials -> Default Application
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_INVOICER_FIRST_NAME=Demo
PAYPAL_INVOICER_LAST_NAME=Freelancer

# Never expose local dev server publicly; these are optional for secured hosted builds only:
DEMO_USERNAME=
DEMO_PASSWORD=
